{
  "name": "awesome-ai-visualization",
  "account_id": "8f1753ad2d5e392716033248d7c5639e",
  "compatibility_date": "2026-09-29",
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "awesome-ai-catalog-qwen3" }],
  "ratelimits": [{ "name": "SEARCH_RATE_LIMITER", "namespace_id": "1007131", "simple": { "limit": 30, "period": 60 } }],
  "routes": [
    {
      "pattern": "awesome-ai-visualization.renaissancemind.ai",
      "custom_domain": true
    }
  ]
}
