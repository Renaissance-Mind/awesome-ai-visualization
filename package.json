{
  "name": "awesome-ai-visualization-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "design:open": "npx -y open-design-ade --open",
    "generate:data": "node scripts/build-frontend-data.mjs && node scripts/build-search-data.mjs",
    "generate:profiles": "node scripts/build-project-profiles.mjs",
    "sync:search": "npm run generate:data && node scripts/sync-search-index.mjs",
    "check:search": "node scripts/verify-search-index.mjs",
    "check:search-api": "node scripts/check-search-api.mjs",
    "predev": "npm run generate:data",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "npx --yes wrangler@4.143.0 dev --remote --port 8787",
    "prebuild": "npm run generate:data",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:frontend": "node scripts/check-frontend.mjs",
    "deploy:cf": "npm run check:frontend && npm run build && npm run check:search && node scripts/prepare-release.mjs && npx --yes wrangler@4.143.0 deploy && npm run check:publication && npm run check:search-api",
    "maintain:publication": "node scripts/maintain-publication.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "test:publication": "node --test tests/publication.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "yaml": "^2.9.0"
  }
}
